{
  "expo": {
    "name": "Jefedo",
    "slug": "JefedoApp",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "scheme": "jefedo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jefedo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EE1217",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.jefedo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31bca846-e3ab-4e85-900c-04c6e074a4ad"
      }
    }
  }
}
